---
/**
 * Switches between light and dark. The choice is saved per device; until the visitor clicks,
 * the site follows the OS setting. BaseLayout applies the saved choice before first paint.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="grid size-10 place-items-center rounded-full text-muted transition-colors hover:bg-surface hover:text-fg"
  aria-label="Dark mode"
  aria-pressed="false"
>
  <!-- Moon: shown in light mode -->
  <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"
    ></path>
  </svg>
  <!-- Sun: shown in dark mode -->
  <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
    ></path>
  </svg>
</button>

<script>
  type Theme = "light" | "dark";
  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");

  function currentTheme(): Theme {
    const chosen = root.dataset["theme"];
    if (chosen === "light" || chosen === "dark") return chosen;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function syncButton(): void {
    button?.setAttribute("aria-pressed", String(currentTheme() === "dark"));
  }

  button?.addEventListener("click", () => {
    const next: Theme = currentTheme() === "dark" ? "light" : "dark";
    root.dataset["theme"] = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      // Storage blocked (private mode): the choice lasts for this page only.
    }
    syncButton();
  });

  syncButton();
</script>
