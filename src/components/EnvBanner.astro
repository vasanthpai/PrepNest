---
import type { AppEnv } from "@/config/app-env";

interface Props {
  env: AppEnv;
}
const { env } = Astro.props;

const labels: Record<Exclude<AppEnv, "production">, string> = {
  local: "Local development",
  staging: "Staging: test data only, not the live site",
};
---

{env !== "production" && (
  <div class="bg-number/15 px-4 py-1.5 text-center font-mono text-xs font-semibold text-number">
    {labels[env]}
  </div>
)}
