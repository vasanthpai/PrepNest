---
import { type Topic, TOPIC_CHIP_CLASSES } from "@/config/topics";

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded-full px-2.5 py-0.5 font-mono text-xs font-semibold",
    TOPIC_CHIP_CLASSES[topic.color],
  ]}
>
  {topic.label}
</span>
