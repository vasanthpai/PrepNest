---
import Logo from "@/components/Logo.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import type { AppEnv } from "@/config/app-env";
import { navFor, site } from "@/config/site";

interface Props {
  env: AppEnv;
}
const { env } = Astro.props;
const items = navFor(env);
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="rounded-md">
      <Logo />
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <nav aria-label="Main">
        <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-semibold">
          {items.map((item) => (
            <li>
              <a href={item.href} class="text-muted hover:text-fg">
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={site.repoUrl} class="text-muted hover:text-fg">
              GitHub
            </a>
          </li>
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
