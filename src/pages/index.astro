---
import "@/styles/global.css";
import HelloIsland from "@/components/HelloIsland";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>PrepNest</title>
  </head>
  <body class="min-h-dvh bg-white font-sans text-slate-900 antialiased">
    <main class="mx-auto max-w-2xl px-4 py-12">
      <h1 class="text-3xl font-bold text-brand-600">PrepNest</h1>
      <p class="mt-2 text-slate-600">Setup check: Tailwind styles + a React island.</p>
      <HelloIsland client:visible />
    </main>
  </body>
</html>
