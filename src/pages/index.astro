---
import TopicChip from "@/components/TopicChip.astro";
import { type FeatureFlag, isFeatureEnabled } from "@/config/features";
import { site } from "@/config/site";
import { topics } from "@/config/topics";
import { blogPageUrl, getBlogForBuild } from "@/features/blog";
import PostList from "@/features/blog/components/PostList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getConfig } from "@/lib/runtime-env";

const { APP_ENV } = getConfig();
const docsUrl = `${site.repoUrl}/blob/main/docs`;
const blog = await getBlogForBuild();
const latestPosts = blog.posts.slice(0, 3);

const pillars: {
  verb: string;
  colorClass: string;
  title: string;
  body: string;
  flag: FeatureFlag;
  version: string;
}[] = [
  {
    verb: "learn()",
    colorClass: "text-function",
    title: "Articles",
    body: "Practical tech articles with runnable examples, from JavaScript basics to system design.",
    flag: "blog",
    version: "v0.2",
  },
  {
    verb: "quiz()",
    colorClass: "text-keyword",
    title: "Quizzes",
    body: "A short quiz after every article, plus timed assessments with topic-by-topic results.",
    flag: "quizzes",
    version: "v0.5",
  },
  {
    verb: "ship()",
    colorClass: "text-string",
    title: "Courses",
    body: "Project-based courses that end with something you build and deploy yourself.",
    flag: "courses",
    version: "v0.7",
  },
];

const stack = [
  "Astro",
  "TypeScript",
  "React",
  "Tailwind CSS",
  "Cloudflare Workers",
  "Neon Postgres",
  "Drizzle",
  "Clerk",
  "Vitest",
  "GitHub Actions",
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-4 pt-14 pb-12 sm:pt-20">
    <p class="font-mono text-xs tracking-widest text-muted uppercase">
      free · hands-on · built in public
    </p>
    <h1 class="mt-4 text-5xl leading-[1.02] font-extrabold tracking-tight sm:text-7xl">
      <span class="text-function">Learn</span> it. <span class="text-keyword">Quiz</span> it.
      <span class="text-string">Ship</span> it.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-muted">
      {site.description} Built step by step, in the open.
    </p>
    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Topics">
      {topics.map((topic) => (
        <li>
          <TopicChip topic={topic} />
        </li>
      ))}
    </ul>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={site.repoUrl} class="btn btn-primary">
        Follow the build on GitHub
      </a>
      <a href={`${docsUrl}/roadmap.md`} class="btn btn-ghost">
        See the roadmap
      </a>
    </div>
  </section>

  <!-- Latest articles (only when the blog is on in this environment) -->
  {blog.enabled && latestPosts.length > 0 && (
    <section class="mx-auto max-w-5xl px-4 py-12" aria-labelledby="latest">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 id="latest" class="text-2xl font-bold sm:text-3xl">
          Latest articles
        </h2>
        <a href={blogPageUrl(1)} class="text-sm font-semibold underline hover:text-function">
          All articles →
        </a>
      </div>
      <div class="mt-6">
        <PostList posts={latestPosts} headingLevel="h3" />
      </div>
    </section>
  )}

  <!-- What's coming -->
  <section class="mx-auto max-w-5xl px-4 py-12" aria-labelledby="pillars">
    <h2 id="pillars" class="text-2xl font-bold sm:text-3xl">
      What you'll find here
    </h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {pillars.map((pillar) => {
        const live = isFeatureEnabled(pillar.flag, APP_ENV);
        return (
          <li class="flex flex-col gap-3 rounded-xl border border-line bg-surface p-5">
            <p class:list={["font-mono text-sm font-semibold", pillar.colorClass]}>{pillar.verb}</p>
            <h3 class="text-xl font-bold">{pillar.title}</h3>
            <p class="text-muted">{pillar.body}</p>
            <p class="mt-auto font-mono text-xs text-muted">
              {live ? "Live now" : `Coming in ${pillar.version}`}
            </p>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- Quiz screen preview -->
  <section class="mx-auto max-w-5xl px-4 py-12" aria-labelledby="preview">
    <div class="grid items-center gap-8 md:grid-cols-2">
      <div>
        <h2 id="preview" class="text-2xl font-bold sm:text-3xl">
          Practice with real code
        </h2>
        <p class="mt-3 max-w-prose text-muted">
          Questions use real snippets, a visible timer and a question palette. Answers are checked
          on the server and only shown after you submit, so scores stay honest.
        </p>
        <p class="mt-3 font-mono text-xs text-muted">
          Preview of the quiz screen · arrives in v0.5
        </p>
      </div>
      <figure
        class="min-w-0 rounded-xl border border-line bg-surface p-5"
        aria-label="Quiz preview"
      >
        <div class="flex flex-wrap justify-between gap-2 font-mono text-xs text-muted">
          <span>Q3 of 10 · JavaScript</span>
          <span class="text-number tabular-nums">01:42 left</span>
        </div>
        <p class="mt-3 font-semibold">What does this log?</p>
        <pre
          role="region"
          aria-label="Code example"
          tabindex="0"
          class="mt-3 overflow-x-auto rounded-lg bg-code p-3 font-mono text-sm"
        ><code>console.<span class="text-function">log</span>([<span class="text-number">1</span>, <span class="text-number">2</span>, <span class="text-number">3</span>].<span class="text-function">map</span>(String)); <span class="text-comment">// ?</span></code></pre>
        <ul class="mt-3 grid gap-2 font-mono text-sm">
          <li class="flex justify-between gap-2 rounded-lg border border-keyword bg-keyword/10 px-3 py-2">
            ["1", "2", "3"] <span class="font-sans text-xs text-muted">selected</span>
          </li>
          <li class="rounded-lg border border-line px-3 py-2">[1, 2, 3]</li>
          <li class="rounded-lg border border-line px-3 py-2">["1,2,3"]</li>
        </ul>
        <figcaption class="mt-3 flex flex-wrap justify-between gap-2 text-xs text-muted">
          <span>Mark for review</span>
          <span>Answers shown after you submit</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Built in public -->
  <section class="mx-auto max-w-5xl px-4 pt-12 pb-20" aria-labelledby="public">
    <div class="rounded-xl border border-line p-6 sm:p-8">
      <h2 id="public" class="text-2xl font-bold sm:text-3xl">
        Built in public
      </h2>
      <p class="mt-3 max-w-prose text-muted">
        Every step is a ticket, a reviewed commit and a log of what changed and why: feature
        branches, CI checks, staging, tagged releases and feature flags.
      </p>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tech stack">
        {stack.map((item) => (
          <li class="rounded-md border border-line px-2 py-1 font-mono text-xs">{item}</li>
        ))}
      </ul>
      <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold">
        <a href={`${docsUrl}/architecture.md`} class="underline hover:text-function">
          Architecture
        </a>
        <a href={`${docsUrl}/roadmap.md`} class="underline hover:text-function">
          Roadmap
        </a>
        <a href={`${docsUrl}/steps/README.md`} class="underline hover:text-function">
          Step logs
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
