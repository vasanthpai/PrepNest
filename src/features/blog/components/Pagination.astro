---
import { blogPageUrl } from "@/features/blog/service";
import type { Page } from "@/lib/pagination";

interface Props {
  page: Page<unknown>;
}
const { page } = Astro.props;
---

{page.totalPages > 1 && (
  <nav
    aria-label="Pagination"
    class="flex items-center justify-between gap-4 text-sm font-semibold"
  >
    {page.hasPrev ? (
      <a href={blogPageUrl(page.page - 1)} rel="prev" class="btn btn-ghost">
        ← Newer
      </a>
    ) : (
      <span />
    )}
    <span class="font-mono text-xs text-muted">
      Page {page.page} of {page.totalPages}
    </span>
    {page.hasNext ? (
      <a href={blogPageUrl(page.page + 1)} rel="next" class="btn btn-ghost">
        Older →
      </a>
    ) : (
      <span />
    )}
  </nav>
)}
