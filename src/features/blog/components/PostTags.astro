---
import { tagUrl } from "@/features/blog/service";

interface Props {
  tags: readonly string[];
}
const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2" aria-label="Tags">
    {tags.map((tag) => (
      <li>
        <a
          href={tagUrl(tag)}
          class="inline-flex rounded-md border border-line px-2 py-1 font-mono text-xs text-muted hover:border-muted hover:text-fg"
        >
          #{tag}
        </a>
      </li>
    ))}
  </ul>
)}
