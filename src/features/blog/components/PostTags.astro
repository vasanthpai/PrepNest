---
interface Props {
  tags: readonly string[];
}
const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2" aria-label="Tags">
    {tags.map((tag) => (
      <li class="rounded-md border border-line px-2 py-1 font-mono text-xs text-muted">#{tag}</li>
    ))}
  </ul>
)}
