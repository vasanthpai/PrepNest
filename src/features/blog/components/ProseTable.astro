---
/**
 * Replaces <table> inside articles (MDX `components` mapping in src/pages/blog/[slug].astro).
 *
 * On phones, wide tables scroll sideways. The scrolling box is a labelled, focusable region so
 * keyboard users can scroll it (WCAG 2.1.1; axe "scrollable-region-focusable") and screen readers
 * announce what got focus. The table inside keeps its normal table semantics.
 */
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"table">;
---

<div class="table-scroll" role="region" aria-label="Table, scrolls sideways" tabindex="0">
  <table {...Astro.props}>
    <slot />
  </table>
</div>
