---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/atkinson-hyperlegible-next";
import "@/styles/global.css";
import EnvBanner from "@/components/EnvBanner.astro";
import Seo, { type Props as SeoProps } from "@/components/Seo.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { isFeatureEnabled } from "@/config/features";
import { site } from "@/config/site";
import { getConfig } from "@/lib/runtime-env";

interface Props extends Omit<SeoProps, "description"> {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  /** Defaults to the site description. */
  description?: string;
  /** false = ask search engines not to list this page (they still follow its links). */
  indexable?: boolean;
}

const { description = site.description, indexable = true, ...seo } = Astro.props;
const { APP_ENV } = getConfig();
const blogEnabled = isFeatureEnabled("blog", APP_ENV);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo description={description} {...seo} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121419" media="(prefers-color-scheme: dark)" />
    {APP_ENV !== "production" ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      !indexable && <meta name="robots" content="noindex, follow" />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {blogEnabled && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={`${site.name} articles`}
        href="/rss.xml"
      />
    )}
    <!-- Apply the saved theme before first paint, so there's no flash of the wrong theme. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked: follow the OS setting.
      }
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-md bg-fg px-3 py-2 text-bg focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <EnvBanner env={APP_ENV} />
    <SiteHeader env={APP_ENV} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter env={APP_ENV} />
  </body>
</html>
