{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Top level = local development (npm run dev)
  "name": "prepnest",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // PUBLIC_CLERK_PUBLISHABLE_KEY is public by design (it is sent to browsers). Local and staging use
  // the "PrepNest staging" Clerk application; production has its own (ADR 0013).
  "vars": {
    "APP_ENV": "local",
    "PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_cGVyZmVjdC10cm91dC05MDAxLmNsZXJrLmFjY291bnRzLmRldiQ",
  },

  // Deployed environments. Selected at BUILD time: CLOUDFLARE_ENV=staging npm run build
  // Note: "vars" are NOT inherited from the top level, so each env repeats them.
  "env": {
    "staging": {
      "name": "prepnest-staging",
      // Pull request previews: https://pr-<n>-prepnest-staging.<subdomain>.workers.dev
      "preview_urls": true,
      "vars": {
        "APP_ENV": "staging",
        "PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_cGVyZmVjdC10cm91dC05MDAxLmNsZXJrLmFjY291bnRzLmRldiQ",
      },
    },
    "production": {
      "name": "prepnest-production",
      // Never reachable through preview URLs: production serves only deployed, tagged releases.
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_d2hvbGUtbHlueC0xMTM4LmNsZXJrLmFjY291bnRzLmRldiQ",
      },
    },
  },
}
